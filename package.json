{
  "name": "aicli",
  "version": "0.2.0",
  "description": "An open-source AI agent that lives in your terminal. Understands your codebase, edits files, runs commands, and helps you ship faster.",
  "keywords": [
    "ai",
    "cli",
    "agent",
    "llm",
    "openai",
    "terminal",
    "coding-assistant",
    "mcp",
    "developer-tools"
  ],
  "homepage": "https://github.com/HarrisonCN/aicli",
  "bugs": {
    "url": "https://github.com/HarrisonCN/aicli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HarrisonCN/aicli.git"
  },
  "license": "Apache-2.0",
  "author": "HarrisonCN",
  "type": "module",
  "bin": {
    "aicli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "openai": "^4.47.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "eslint": "^9.5.0",
    "prettier": "^3.3.2",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
