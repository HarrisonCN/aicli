{
  "name": "aicli",
  "version": "0.1.0",
  "description": "An open-source AI agent that lives in your terminal. Understands your codebase, browses the web, runs commands, and helps you ship faster.",
  "keywords": [
    "ai",
    "cli",
    "agent",
    "llm",
    "openai",
    "terminal",
    "coding-assistant",
    "mcp",
    "developer-tools"
  ],
  "homepage": "https://github.com/HarrisonCN/aicli",
  "bugs": {
    "url": "https://github.com/HarrisonCN/aicli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HarrisonCN/aicli.git"
  },
  "license": "Apache-2.0",
  "author": "HarrisonCN",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aicli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "openai": "^4.47.0",
    "ora": "^8.0.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "eslint": "^9.5.0",
    "prettier": "^3.3.2",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
